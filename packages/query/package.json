{
  "name": "@friday-friday/query",
  "version": "0.0.0",
  "private": true,
  "description": "TanStack Query adapter: Err becomes query.error (thrown plain E), Ok(undefined) -> null, signal forwarding, retryUnless (Design Report section 5.4)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericbfriday/fp-ts-sandbox1.git",
    "directory": "packages/query"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@friday-friday/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@friday-friday/core": "workspace:^",
    "@tanstack/query-core": "^5.62"
  },
  "devDependencies": {
    "@friday-friday/core": "workspace:*",
    "@tanstack/query-core": "^5.107.1",
    "@tanstack/react-query": "5.107.1",
    "@types/react": "^19.3.0",
    "react": "19.3.1"
  },
  "scripts": {
    "build": "tsdown",
    "smoke": "node test/smoke.mjs"
  }
}
