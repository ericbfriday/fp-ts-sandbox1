{
  "name": "@friday-friday/trpc",
  "version": "0.0.0",
  "private": true,
  "description": "tRPC v11 adapter: dual-channel Results via resultMiddleware + errorFormatter (data.friday_friday member via core /wire) + fromTRPC reconstruction (Design Report section 5.3)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericbfriday/fp-ts-sandbox1.git",
    "directory": "packages/trpc"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@friday-friday/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@friday-friday/core": "workspace:^",
    "@friday-friday/schema": "workspace:^",
    "@trpc/server": "^11"
  },
  "devDependencies": {
    "@friday-friday/core": "workspace:*",
    "@friday-friday/schema": "workspace:*",
    "@trpc/client": "^11.28.3",
    "@trpc/server": "^11.28.3",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsdown",
    "smoke": "node test/smoke.mjs"
  }
}
