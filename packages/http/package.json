{
  "name": "@friday-friday/http",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP client adapter: fetchResult with schema decode + RFC 9457 problem+json reconstruction (Design Report section 5.9)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericbfriday/fp-ts-sandbox1.git",
    "directory": "packages/http"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@friday-friday/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@friday-friday/core": "workspace:^",
    "@friday-friday/schema": "workspace:^"
  },
  "devDependencies": {
    "@friday-friday/core": "workspace:*",
    "@friday-friday/schema": "workspace:*",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsdown",
    "smoke": "node test/smoke.mjs"
  }
}
