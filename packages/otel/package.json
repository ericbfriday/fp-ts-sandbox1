{
  "name": "@friday-friday/otel",
  "version": "0.0.0",
  "private": true,
  "description": "OpenTelemetry span helpers for Results: traced(name, fn) marks Err as span ERROR with friday_friday.error.tag, records defects as exceptions (Design Report section 3.6 observability)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericbfriday/fp-ts-sandbox1.git",
    "directory": "packages/otel"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@friday-friday/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@friday-friday/core": "workspace:^",
    "@opentelemetry/api": "^1"
  },
  "devDependencies": {
    "@friday-friday/core": "workspace:*",
    "@opentelemetry/api": "^1.9.0"
  },
  "scripts": {
    "build": "tsdown",
    "smoke": "node test/smoke.mjs"
  }
}
