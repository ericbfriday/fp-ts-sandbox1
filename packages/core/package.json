{
  "name": "@friday-friday/core",
  "version": "0.0.0",
  "private": true,
  "description": "Plain-object Result, tagged errors, dual combinators and boundary triage — sync surface plus /async (retry/timeout/concurrency) /gen (do-notation) and /wire (sanitize, RFC 9457 problem out/in, defect envelope) subpaths",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@friday-friday/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./async": {
      "@friday-friday/source": "./src/async.ts",
      "types": "./dist/async.d.ts",
      "default": "./dist/async.js"
    },
    "./gen": {
      "@friday-friday/source": "./src/gen.ts",
      "types": "./dist/gen.d.ts",
      "default": "./dist/gen.js"
    },
    "./wire": {
      "@friday-friday/source": "./src/wire.ts",
      "types": "./dist/wire.d.ts",
      "default": "./dist/wire.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "smoke": "node test/smoke.mjs"
  }
}
