{
  "name": "@friday-friday/fp-ts-sandbox1",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Sandbox for functional-programming TypeScript experiments",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "check": "tsc -p tsconfig.json && tsc -p examples/next-app/tsconfig.json && node tooling/type-budget/src/check.ts",
    "lint": "oxlint -f unix && pnpm -r --filter \"./tooling/eslint-plugin\" run lint && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "size": "pnpm run build && size-limit",
    "smoke": "pnpm -r --filter \"./packages/*\" run smoke",
    "build:examples": "pnpm -r --filter \"./examples/*\" run build",
    "ci": "pnpm run lint && pnpm run check && pnpm run test && pnpm run size && pnpm run smoke && pnpm run build:examples"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^24.19.2",
    "dprint": "^0.57.4",
    "fast-check": "^4.10.2",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
