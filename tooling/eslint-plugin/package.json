{
  "name": "@friday-friday/eslint-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Local type-aware lint rules: must-use-result, no-try-around-redirect, no-instanceof-tagged-error (ADR-0003; rules land in #8)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericbfriday/fp-ts-sandbox1.git",
    "directory": "tooling/eslint-plugin"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "cd ../.. && eslint --config tooling/eslint-plugin/eslint.config.js --max-warnings 0 packages examples"
  },
  "devDependencies": {
    "@typescript-eslint/utils": "~8.72.2",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.2",
    "@friday-friday/core": "workspace:*"
  }
}
